# Server Configuration
PORT=5001
FRONTEND_URL=http://localhost:5174

# Database Connections
DATABASE_URL="postgresql://user:password@localhost:5432/studypilot"
MONGO_URI="mongodb://localhost:27017/studypilot_conversations"
